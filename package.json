{
  "name": "openclaw-whisper-server",
  "version": "0.1.3",
  "description": "Local, offline speech-to-text (STT) for OpenClaw: transcribe voice messages and audio on your own machine through a resident whisper.cpp server. Private voice transcription with no cloud fallback, and the Whisper model stays loaded between requests.",
  "type": "module",
  "license": "MIT",
  "author": "rickysinghmba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickysinghmba/openclaw-whisper-server.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "whisper",
    "whisper.cpp",
    "speech-to-text",
    "stt",
    "transcription",
    "voice",
    "voice-messages",
    "audio",
    "offline",
    "local",
    "private",
    "self-hosted"
  ],
  "files": [
    "dist",
    "assets",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.34"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.34",
      "minGatewayVersion": "2026.10.34"
    },
    "build": {
      "openclawVersion": "2026.11.10",
      "pluginSdkVersion": "2026.11.10"
    }
  },
  "homepage": "https://github.com/rickysinghmba/openclaw-whisper-server#readme",
  "bugs": {
    "url": "https://github.com/rickysinghmba/openclaw-whisper-server/issues"
  }
}
